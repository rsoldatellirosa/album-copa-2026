# Supabase — copie do painel do seu projeto: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...sua-anon-key
# Chave secreta (NUNCA exponha no client / commit). Usada só nos scripts e nas rotas de servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJ...sua-service-role-key

# PIN que desbloqueia a edição no site (escolha um valor secreto)
EDIT_TOKEN=troque-este-pin
